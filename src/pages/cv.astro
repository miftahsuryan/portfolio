  <script>
    function setupCvSwitcher() {
      const switchBtns = document.querySelectorAll<HTMLButtonElement>('[data-switch-view]');
      const atsView = document.getElementById('cv-ats-container');
      const visualView = document.getElementById('cv-visual-container');
      const printBtn = document.querySelector<HTMLButtonElement>('[data-print-action]');
      const downloadLink = document.getElementById('download-active-pdf') as HTMLAnchorElement | null;

      function setView(view: 'ats' | 'visual') {
        switchBtns.forEach((btn) => {
          const isActive = btn.getAttribute('data-switch-view') === view;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        if (view === 'ats') {
          if (atsView) atsView.style.display = 'flex';
          if (visualView) visualView.style.display = 'none';
          if (downloadLink) {
            downloadLink.href = '/cv-ats.pdf';
            downloadLink.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg><span>Unduh CV ATS (PDF)</span>';
          }
        } else {
          if (atsView) atsView.style.display = 'none';
          if (visualView) visualView.style.display = 'flex';
          if (downloadLink) {
            downloadLink.href = '/cv-visual.pdf';
            downloadLink.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg><span>Unduh CV Visual (PDF)</span>';
          }
        }

        // Sync query parameter tanpa reload
        const url = new URL(window.location.href);
        url.searchParams.set('type', view);
        window.history.replaceState({}, '', url.toString());
      }

      switchBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-switch-view') as 'ats' | 'visual';
          setView(target);
        });
      });

      printBtn?.addEventListener('click', () => {
        window.print();
      });

      // Inisialisasi dari URL query param (?type=visual atau ?type=ats)
      const params = new URLSearchParams(window.location.search);
      const initialType = params.get('type') === 'visual' ? 'visual' : 'ats';
      setView(initialType);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCvSwitcher);
    } else {
      setupCvSwitcher();
    }
  </script>
