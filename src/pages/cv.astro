---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import {
  Printer,
  Download,
  ArrowLeft,
  Mail,
  Phone,
  MapPin,
  Globe,
  Award,
  BookOpen,
  Briefcase,
  Layers,
  GraduationCap,
} from '@lucide/astro';
import formalPhoto from '../assets/profile/foto_profile_formal.jpg';
import { getProfile, getSkillGroups, getProjects, hasCvPdf, isLink } from '../lib/content';

const p = getProfile();
const groups = getSkillGroups();
const allProjects = await getProjects();
const pdf = hasCvPdf();
const e = p.education;
const hs = p.highSchool;
const exp = p.experience ?? [];

const cvRole = "Informatics Graduate | Data & Machine Learning Enthusiast";
const bare = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const isVideo = (u?: string | null) => !!u && /(youtube\.com|youtu\.be)/i.test(u);

// Kurasi 6 sertifikasi berbobot tinggi untuk efisiensi ruang ATS
const curatedCertNames = [
  'Belajar Pengembangan Machine Learning',
  'Machine Learning Terapan',
  'Belajar Machine Learning untuk Pemula',
  'Belajar Fundamental Pemrosesan Data',
  'English for Business Communication',
  'Test of English Competence (TOEC)',
];

const cvCertifications = p.certifications.filter((c) =>
  curatedCertNames.some((name) => c.name.toLowerCase().includes(name.toLowerCase()))
);

const cvTraining = p.training.filter((t) =>
  t.name.toLowerCase().includes('coding camp') || t.name.toLowerCase().includes('dbs')
);

const cvAchievements = p.achievements.filter(
  (a) => !a.title.toLowerCase().includes('samsung')
);

const cvOrganizations = p.organizations.filter(
  (o) => !o.role.toLowerCase().includes('panitia')
);

// Kurasi 4 proyek unggulan berformat XYZ untuk CV
const projAga = allProjects.find((pr) => pr.id.includes('proyek-1')) ?? allProjects[0];
const projQuant = allProjects.find((pr) => pr.id.includes('proyek-2')) ?? allProjects[1];
const projWisata = allProjects.find((pr) => pr.id.includes('proyek-3')) ?? allProjects[2];
const projSic = allProjects.find((pr) => pr.id.includes('proyek-5')) ?? allProjects[4];

// Format nomor telepon untuk tampilan rapi
const formattedPhone = p.contact.phone
  ? p.contact.phone.replace(/(\d{4})(\d{4})(\d{4})/, '$1-$2-$3')
  : '0812-5778-0379';
const cleanPhone = p.contact.phone || '081257780379';
---

<BaseLayout
  title={`CV · ${p.name}`}
  description={`Curriculum Vitae ${p.name} - ${cvRole} (Format ATS & Visual)`}
  path="/cv"
  bare
>
  <div class="wrap cv-container">
    {/* ===== ACTION BAR & VIEW SWITCHER (Screen Only) ===== */}
    <nav class="actions no-print" aria-label="Kontrol Tampilan & Ekspor CV">
      <a class="back-link" href="/">
        <ArrowLeft size={16} aria-hidden="true" />
        <span>Kembali ke Beranda</span>
      </a>

      <div class="view-switcher" role="tablist" aria-label="Pilih Format CV">
        <button
          type="button"
          class="switch-btn active"
          data-switch-view="ats"
          role="tab"
          aria-selected="true"
          aria-controls="cv-ats-container"
        >
          <Layers size={15} aria-hidden="true" />
          <span>Tipe 1: Standar ATS (1 Kolom)</span>
        </button>
        <button
          type="button"
          class="switch-btn"
          data-switch-view="visual"
          role="tab"
          aria-selected="false"
          aria-controls="cv-visual-container"
        >
          <Briefcase size={15} aria-hidden="true" />
          <span>Tipe 2: Visual 2-Kolom (SIAPkerja)</span>
        </button>
      </div>

      <div class="export-buttons">
        <button type="button" class="btn btn-primary" data-print-action>
          <Printer size={16} aria-hidden="true" />
          <span>Cetak / Simpan PDF</span>
        </button>
        <a class="btn btn-outline" href="/cv.pdf" download id="download-active-pdf">
          <Download size={16} aria-hidden="true" />
          <span>Unduh cv.pdf (A4 Resmi)</span>
        </a>
      </div>
    </nav>

    {/* =========================================================================
        TIPE 1: CV STANDAR ATS 2026 (1 Kolom Murni Minimalis — Sesuai PDF 1)
        ========================================================================= */}
    <div class="cv-layout cv-ats-view" id="cv-ats-container">
      {/* --- HALAMAN 1 (ATS) --- */}
      <div class="cv-sheet ats-sheet">
        {/* Header Kontak */}
        <header class="ats-header">
          <h1 class="ats-name">{p.name}</h1>
          <p class="ats-contact-line">
            <span>{p.contact.domicile || 'Kab. Paser, Kalimantan Timur (Domisili: DI Yogyakarta)'}</span>
            <span class="sep">|</span>
            <a href={`mailto:${p.contact.email}`} class="ats-link">{p.contact.email}</a>
            <span class="sep">|</span>
            <a href={`https://wa.me/62${cleanPhone.replace(/^0/, '')}`} class="ats-link">{cleanPhone}</a>
          </p>
          <p class="ats-contact-subline">
            <span>Portofolio: <a href={p.siteUrl} target="_blank" rel="noopener noreferrer" class="ats-link">{bare(p.siteUrl)}</a></span>
            <span class="sep">|</span>
            {isLink(p.contact.linkedin) && (
              <a href={p.contact.linkedin} target="_blank" rel="noopener noreferrer" class="ats-link">LinkedIn Profile</a>
            )}
            <span class="sep">|</span>
            {isLink(p.contact.github) && (
              <a href={p.contact.github} target="_blank" rel="noopener noreferrer" class="ats-link">GitHub Repository</a>
            )}
          </p>
        </header>

        {/* Ringkasan Profesional */}
        <section class="ats-section">
          <h2 class="ats-heading">Ringkasan Profesional</h2>
          <p class="ats-text">
            Lulusan S1 Informatika UIN Sunan Kalijaga (IPK 3,77/4,00, Cumlaude) dengan keahlian inti pada Machine Learning, analisis data kuantitatif, dan data pipeline berbasis Python. Memiliki rekam jejak dalam merancang sistem optimasi portofolio investasi saham dengan Algoritma Genetika Adaptif (menghasilkan Total Return 46,51% dan Sharpe Ratio 2,10) serta arsitektur sistem rekomendasi hybrid. Teruji menyelesaikan program intensif 936 jam Coding Camp DBS Foundation dengan predikat Nilai A (90,7) dan memiliki pengalaman kepemimpinan sebagai Bendahara Umum serta Ketua Divisi Olahraga mahasiswa. Terbiasa bekerja dalam ekosistem spec-driven development dan siap memberikan dampak nyata di dunia industri.
          </p>
        </section>

        {/* Riwayat Pendidikan */}
        <section class="ats-section">
          <h2 class="ats-heading">Riwayat Pendidikan</h2>
          <div class="ats-item">
            <div class="ats-item-header">
              <span class="ats-item-title"><strong>{e.institution}</strong> — Yogyakarta, Indonesia</span>
              <span class="ats-item-period">{e.period}</span>
            </div>
            <p class="ats-item-sub">
              {e.degree} · Fakultas Sains dan Teknologi · <strong>IPK {e.gpa} (Predikat Cumlaude)</strong>
            </p>
            {e.thesis && (
              <p class="ats-thesis-line">
                <strong>Tugas Akhir / Skripsi:</strong> <em>{e.thesis}</em>
              </p>
            )}
          </div>

          {hs && (
            <div class="ats-item" style="margin-top: 0.25rem;">
              <div class="ats-item-header">
                <span class="ats-item-title"><strong>{hs.institution}</strong> — {hs.location}</span>
                <span class="ats-item-period">{hs.period}</span>
              </div>
              <p class="ats-item-sub">
                Jurusan {hs.major} · <strong>Nilai Rata-Rata Kelulusan: {hs.score}</strong>
              </p>
            </div>
          )}
        </section>

        {/* Pengalaman Kerja */}
        <section class="ats-section">
          <h2 class="ats-heading">Pengalaman Kerja</h2>
          {exp.map((item) => (
            <article class="ats-item">
              <div class="ats-item-header">
                <span class="ats-item-title"><strong>{item.company}</strong> — {item.location}</span>
                <span class="ats-item-period">{item.period}</span>
              </div>
              <p class="ats-item-role"><em>{item.role}</em></p>
              <ul class="ats-bullet-list">
                {item.highlights ? (
                  item.highlights.map((hl) => <li>{hl}</li>)
                ) : (
                  <li>{item.summary}</li>
                )}
              </ul>
            </article>
          ))}
        </section>

        {/* Pengalaman Proyek Unggulan (Halaman 1: Proyek 01) */}
        <section class="ats-section">
          <h2 class="ats-heading">Pengalaman Proyek & Riset Pilihan</h2>

          {/* Proyek 01: IDX30 AGA */}
          <article class="ats-item">
            <div class="ats-item-header">
              <span class="ats-item-title"><strong>{projAga.data.title}</strong></span>
              <span class="ats-item-period">{projAga.data.period}</span>
            </div>
            <div class="ats-item-links">
              <span>{projAga.data.role}</span>
              <span class="ats-links-group">
                {isLink(projAga.data.repoUrl) && (
                  <a href={projAga.data.repoUrl} target="_blank" rel="noopener noreferrer" class="ats-doc-link">[GitHub Repository]</a>
                )}
                {isLink(projAga.data.demoUrl) && (
                  <>
                    <span class="sep">|</span>
                    <a href={projAga.data.demoUrl} target="_blank" rel="noopener noreferrer" class="ats-doc-link">[Live Demo Terminal]</a>
                  </>
                )}
              </span>
            </div>
            <ul class="ats-bullet-list">
              <li>Mengembangkan engine optimasi alokasi bobot 22 konstituen saham IDX30 menggunakan Adaptive Genetic Algorithm (AGA) dengan operator probabilitas adaptif Srinivas & Patnaik dan penalti diversifikasi Herfindahl-Hirschman Index (HHI).</li>
              <li>Mencapai <strong>Total Return 46,51%</strong> (mengungguli tolok ukur pasar IDX30 sebesar +33,03%), <strong>Sharpe Ratio 2,1036</strong> (vs 0,3767), dan <strong>Max Drawdown -15,74%</strong> pada validasi 4-fase expanding Walk-Forward.</li>
              <li>Memvalidasi keunggulan performa model melalui 80 kali simulasi stokastik dengan uji hipotesis inferensial berpasangan (Shapiro-Wilk, Paired t-test, dan Wilcoxon Signed-Rank, <em>p &lt; 0,001</em>).</li>
              <li>Mendeploy terminal riset kuantitatif interaktif berbasis Streamlit Cloud dengan kalkulator alokasi lot saham riil bursa (1 lot = 100 lembar).</li>
            </ul>
          </article>

          {/* Proyek 02: IDX Quant Studio */}
          <article class="ats-item" style="margin-top: 0.35rem;">
            <div class="ats-item-header">
              <span class="ats-item-title"><strong>{projQuant.data.title}</strong></span>
              <span class="ats-item-period">{projQuant.data.period}</span>
            </div>
            <div class="ats-item-links">
              <span>{projQuant.data.role}</span>
              <span class="ats-links-group">
                {isLink(projQuant.data.repoUrl) && (
                  <a href={projQuant.data.repoUrl} target="_blank" rel="noopener noreferrer" class="ats-doc-link">[GitHub Repository]</a>
                )}
              </span>
            </div>
            <ul class="ats-bullet-list">
              <li>Merancang workstation analitik finansial komprehensif untuk 970+ emiten Bursa Efek Indonesia (BEI) menggunakan pipeline penyimpanan data DuckDB dan partisi Apache Parquet.</li>
              <li>Mengintegrasikan modul valuasi fundamental sektoral Aswath Damodaran (DDM & DCF) serta lapis mitigasi halusinasi AI berdasar Typed Fact Layer.</li>
              <li>Membuktikan ketahanan strategi melalui backtest Walk-Forward 40:30:30 bebas look-ahead bias dengan raihan Alpha <strong>+15,68% vs IHSG</strong> pada pengujian out-of-sample riil.</li>
            </ul>
          </article>
        </section>
      </div>

      {/* --- HALAMAN 2 (ATS) --- */}
      <div class="cv-sheet ats-sheet ats-page-break">
        {/* Lanjutan Proyek (Proyek 03 & 05) */}
        <section class="ats-section">
          <h2 class="ats-heading">Lanjutan Proyek Riset & Rekayasa Perangkat Lunak</h2>

          {/* Proyek 03: WisataPas */}
          <article class="ats-item">
            <div class="ats-item-header">
              <span class="ats-item-title"><strong>{projWisata.data.title}</strong></span>
              <span class="ats-item-period">{projWisata.data.period}</span>
            </div>
            <div class="ats-item-links">
              <span>{projWisata.data.role}</span>
              <span class="ats-links-group">
                {isLink(projWisata.data.repoUrl) && (
                  <a href={projWisata.data.repoUrl} target="_blank" rel="noopener noreferrer" class="ats-doc-link">[GitHub Repository]</a>
                )}
                {isLink(projWisata.data.demoUrl) && (
                  <>
                    <span class="sep">|</span>
                    <a href={projWisata.data.demoUrl} target="_blank" rel="noopener noreferrer" class="ats-doc-link">[Live Demo]</a>
                  </>
                )}
              </span>
            </div>
            <ul class="ats-bullet-list">
              <li>Membangun arsitektur sistem rekomendasi hybrid mengombinasikan Content-Based Filtering (Cosine Similarity) dan Collaborative Filtering berbasis Deep Learning (RecommenderNet TensorFlow).</li>
              <li>Meraih predikat <strong>Capstone Project Terbaik</strong> Coding Camp DBS Foundation 2025 dengan skor <strong>95,6 / 100</strong> dan mencatatkan Root Mean Squared Error (RMSE) 0,3329 pada data uji evaluasi.</li>
            </ul>
          </article>

          {/* Proyek 05: SIC5 IoT Tunarungu */}
          <article class="ats-item" style="margin-top: 0.35rem;">
            <div class="ats-item-header">
              <span class="ats-item-title"><strong>{projSic.data.title}</strong></span>
              <span class="ats-item-period">{projSic.data.period}</span>
            </div>
            <div class="ats-item-links">
              <span>{projSic.data.role}</span>
              <span class="ats-links-group">
                {isLink(projSic.data.demoUrl) && (
                  <a href={projSic.data.demoUrl} target="_blank" rel="noopener noreferrer" class="ats-doc-link">[Video Demonstrasi Produk]</a>
                )}
              </span>
            </div>
            <ul class="ats-bullet-list">
              <li>Merancang dan menguji prototipe perangkat keras IoT berbasis mikrokontroler ESP32 dan model Speech-to-Text untuk mengonversi pengumuman audio di fasilitas publik menjadi teks visual ramah tunarungu.</li>
              <li>Terpilih sebagai <strong>Semi Finalis Nasional Samsung Innovation Campus Batch 5 (2024)</strong> dan meraih predikat <strong>Master (skor 95,63)</strong> pada tahap seleksi Coding & Programming (Python, Algorithm & Data Structure).</li>
            </ul>
          </article>
        </section>

        {/* Keahlian Teknis (Hard Skills) */}
        <section class="ats-section">
          <h2 class="ats-heading">Keahlian Teknis (Skills)</h2>
          <div class="ats-skills-grid">
            {groups.map((g) => (
              <div class="ats-skill-line">
                <span class="ats-skill-cat"><strong>{g.category}:</strong></span>
                <span class="ats-skill-items">{g.items.map((i) => i.name).join(', ')}</span>
              </div>
            ))}
            <div class="ats-skill-line">
              <span class="ats-skill-cat"><strong>Bahasa:</strong></span>
              <span class="ats-skill-items">Bahasa Indonesia (Penutur Asli), Bahasa Inggris (TOEC Skor 443 · TBI English for Business Communication 86%)</span>
            </div>
          </div>
        </section>

        {/* Pelatihan & Sertifikasi Terverifikasi */}
        <section class="ats-section">
          <h2 class="ats-heading">Pelatihan & Sertifikasi Terverifikasi</h2>
          <ul class="ats-compact-list">
            {cvTraining.map((t) => {
              const link = t.driveUrl ?? t.verificationUrl;
              return (
                <li class="ats-compact-item">
                  <div class="ats-item-header">
                    <span class="ats-item-title"><strong>{t.name} ({t.hours ?? '936 Jam'})</strong> — {t.issuer}</span>
                    <span class="ats-item-period">{t.period}</span>
                  </div>
                  <p class="ats-item-meta">
                    {t.note}
                    {t.credentialId && (
                      <> · Kredensial: {link ? <a href={link} target="_blank" rel="noopener noreferrer" class="ats-id-link">{t.credentialId}</a> : t.credentialId}</>
                    )}
                  </p>
                </li>
              );
            })}
            {cvCertifications.map((c) => {
              const link = c.verificationUrl ?? c.driveUrl;
              return (
                <li class="ats-compact-item">
                  <div class="ats-item-header">
                    <span class="ats-item-title"><strong>{c.name}</strong>{c.hours && ` (${c.hours})`} — {c.issuer}</span>
                    <span class="ats-item-period">{c.year}</span>
                  </div>
                  <p class="ats-item-meta">
                    {c.credentialId && (
                      <>Kredensial ID: {link ? <a href={link} target="_blank" rel="noopener noreferrer" class="ats-id-link">{c.credentialId}</a> : c.credentialId}</>
                    )}
                  </p>
                </li>
              );
            })}
          </ul>
        </section>

        {/* Organisasi & Pencapaian */}
        <section class="ats-section">
          <h2 class="ats-heading">Organisasi & Pencapaian</h2>
          <ul class="ats-compact-list">
            {cvOrganizations.map((o) => (
              <li class="ats-compact-item">
                <div class="ats-item-header">
                  <span class="ats-item-title"><strong>{o.role}</strong> — {o.org}</span>
                  <span class="ats-item-period">{o.period}</span>
                </div>
                {o.note && <p class="ats-item-meta">{o.note}</p>}
              </li>
            ))}
            {cvAchievements.map((a) => (
              <li class="ats-compact-item">
                <div class="ats-item-header">
                  <span class="ats-item-title"><strong>{a.title}</strong></span>
                  <span class="ats-item-period">{a.year}</span>
                </div>
                {a.note && <p class="ats-item-meta">{a.note}</p>}
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    {/* =========================================================================
        TIPE 2: CV VISUAL MODERN 2-KOLOM (Gaya SIAPkerja — Sesuai PDF 2)
        ========================================================================= */}
    <div class="cv-layout cv-visual-view" id="cv-visual-container" style="display: none;">
      {/* --- HALAMAN 1 (VISUAL) --- */}
      <div class="cv-sheet visual-sheet">
        {/* Sidebar Kiri (Teal) */}
        <aside class="visual-sidebar">
          <div class="visual-avatar-wrap">
            <Image
              src={formalPhoto}
              alt={p.name}
              class="visual-avatar-img"
              width={260}
              height={260}
              loading="eager"
            />
          </div>

          <div class="sidebar-block">
            <h3 class="sidebar-title">Kontak</h3>
            <ul class="sidebar-contact-list">
              <li>
                <Mail size={13} class="sidebar-icon" aria-hidden="true" />
                <a href={`mailto:${p.contact.email}`}>{p.contact.email}</a>
              </li>
              <li>
                <Phone size={13} class="sidebar-icon" aria-hidden="true" />
                <a href={`https://wa.me/62${cleanPhone.replace(/^0/, '')}`}>{formattedPhone}</a>
              </li>
              <li>
                <MapPin size={13} class="sidebar-icon" aria-hidden="true" />
                <span>{p.contact.domicile || 'Kab. Paser, Kalimantan Timur (Domisili: DI Yogyakarta)'}</span>
              </li>
              <li>
                <Globe size={13} class="sidebar-icon" aria-hidden="true" />
                <a href={p.siteUrl} target="_blank" rel="noopener noreferrer">{bare(p.siteUrl)}</a>
              </li>
              {isLink(p.contact.linkedin) && (
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-icon" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                  <a href={p.contact.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/miftahullah-surya-nugraha</a>
                </li>
              )}
              {isLink(p.contact.github) && (
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-icon" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  <a href={p.contact.github} target="_blank" rel="noopener noreferrer">github.com/miftahsuryan</a>
                </li>
              )}
            </ul>
          </div>

          <div class="sidebar-block">
            <h3 class="sidebar-title">Skills</h3>
            <ul class="sidebar-skills-list">
              <li>Machine Learning</li>
              <li>Portfolio Optimization</li>
              <li>Quantitative Analytics</li>
              <li>Data Processing & ETL</li>
              <li>Deep Learning (TF & PyTorch)</li>
              <li>Natural Language Processing (NLP)</li>
              <li>Algorithms & Data Structures</li>
              <li>Python Programming</li>
              <li>SQL & DuckDB Database</li>
              <li>Data Visualization (Plotly & Streamlit)</li>
              <li>Git & Version Control</li>
            </ul>
          </div>

          <div class="sidebar-block">
            <h3 class="sidebar-title">Bahasa</h3>
            <ul class="sidebar-skills-list">
              <li>Bahasa Indonesia (Penutur Asli)</li>
              <li>English (TOEC Skor 443 · TBI 86%)</li>
            </ul>
          </div>

          <div class="sidebar-badge-siap">
            <span class="siap-logo-text">SIAPkerja 2026</span>
            <span class="siap-sub-text">Terverifikasi Standar Kemnaker</span>
          </div>
        </aside>

        {/* Konten Kanan (Putih) */}
        <main class="visual-main">
          <header class="visual-header">
            <h1 class="visual-name">{p.name}</h1>
            <p class="visual-role">{cvRole}</p>
          </header>

          <section class="visual-section">
            <h2 class="visual-heading">Tentang Saya</h2>
            <p class="visual-summary">
              Kunjungi portofolio proyek saya di: <a href={p.siteUrl} target="_blank" rel="noopener noreferrer" class="visual-link">{bare(p.siteUrl)}</a> | Lulusan S1 Informatika UIN Sunan Kalijaga (IPK 3,77, Cumlaude) dengan keahlian inti pada Machine Learning, analisis data kuantitatif, dan data pipeline berbasis Python. Memiliki rekam jejak dalam merancang sistem optimasi portofolio saham (Algoritma Genetika Adaptif), sistem rekomendasi hybrid (WisataPas), dan workstation kuantitatif (IDX Quant Studio). Kompetensi teknis ini divalidasi melalui predikat Full Graduate Coding Camp DBS Foundation 2025 (Nilai A / 90,7). Dengan memadukan daya analitik dan pengalaman manajerial sebagai Ketua Divisi Basket serta Bendahara Umum IMM Fakultas, saya siap memberikan dampak nyata di dunia industri.
            </p>
