---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/content';

interface Props {
  path: string | null;
  alt: string;
  label: string; // petunjuk yang tampil di kerangka placeholder
  ratio?: string;
  priority?: boolean; // true hanya untuk gambar LCP di atas lipatan
  widths?: number[];
  sizes?: string;
}
const { path, alt, label, ratio = '4 / 3', priority = false, widths = [480, 800, 1200], sizes } = Astro.props;

const img = resolveImage(path);
// Kerangka placeholder hanya muncul saat dev/pratinjau; build produksi tidak merender apa pun.
const showFrame = !img && (import.meta.env.DEV || process.env.ALLOW_TODO === 'true');
---

{img && (
  <figure class="slot" style={`--ratio: ${ratio}`}>
    <Image
      src={img}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? undefined : 'async'}
    />
  </figure>
)}
{showFrame && (
  <div class="slot frame" style={`--ratio: ${ratio}`} role="note">
    <p>Slot gambar: {label}</p>
  </div>
)}

<style>
  .slot {
    aspect-ratio: var(--ratio);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-2);
  }
  .slot :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .frame {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    border-style: dashed;
    color: var(--text-2);
    font-size: var(--step--1);
    text-align: center;
  }
</style>

