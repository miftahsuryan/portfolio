---
import { ExternalLink, CircleCheck, Award } from '@lucide/astro';
import CertificateShowcase from './CertificateShowcase.astro';
import ImageSlot from './ImageSlot.astro';
import { getProfile, isLink } from '../lib/content';

const p = getProfile();
---

<section class="section" id="pencapaian" aria-labelledby="pencapaian-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="pencapaian-title">Pelatihan Industri</h2>
      <p class="section-lead">
        Program intensif berstandar industri dan kompetisi teknologi tingkat nasional.
      </p>
    </div>

    <div class="programs-grid">
      {/* Card 1: DBS Foundation Coding Camp */}
      {p.training.map((t) => (
        <article class="program-card">
          {t.image && (
            <div class="program-thumb">
              <ImageSlot
                path={t.image}
                alt={`Sertifikat ${t.name}`}
                label={t.name}
                ratio="1.414 / 1"
                widths={[360, 600]}
                sizes="(min-width: 48rem) 28rem, 90vw"
              />
            </div>
          )}
          <div class="program-body">
            <div class="badge-row">
              {t.grade && <span class="badge badge-accent">{t.grade}</span>}
              {t.hours && <span class="badge">{t.hours}</span>}
              {t.specialization && <span class="badge badge-outline">{t.specialization}</span>}
            </div>
            <h3 class="program-title">{t.name}</h3>
            <p class="program-issuer">{t.issuer} · {t.period}</p>
            
            {t.highlights && (
              <ul class="program-highlights">
                {t.highlights.map((h) => (
                  <li>
                    <CircleCheck size={14} class="check-icon" aria-hidden="true" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="card-links">
              {isLink(t.driveUrl) && (
                <a href={t.driveUrl} target="_blank" rel="noopener" class="card-link primary">
                  <span>Sertifikat Kelulusan (PDF)</span>
                  <ExternalLink size={13} aria-hidden="true" />
                </a>
              )}
              {isLink(t.folderUrl) && (
                <a href={t.folderUrl} target="_blank" rel="noopener" class="card-link">
                  <span>Folder Drive DBS</span>
                  <ExternalLink size={13} aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))}

      {/* Card 2: Samsung Innovation Campus Batch 5 */}
      {p.achievements.filter(a => a.stages).map((a) => (
        <article class="program-card">
          {a.image && (
            <div class="program-thumb">
              <ImageSlot
                path={a.image}
                alt={`Sertifikat ${a.title}`}
                label={a.title}
                ratio="1.414 / 1"
                widths={[360, 600]}
                sizes="(min-width: 48rem) 28rem, 90vw"
              />
            </div>
          )}
          <div class="program-body">
            <div class="badge-row">
              <span class="badge badge-accent">Semi Finalist Nasional</span>
              <span class="badge">{a.year}</span>
              <span class="badge badge-outline">IoT & AI Track</span>
            </div>
            <h3 class="program-title">{a.title}</h3>
            {a.issuer && <p class="program-issuer">{a.issuer}</p>}
            {a.note && <p class="program-note">{a.note}</p>}

            {a.stages && (
              <div class="stages-strip">
                <span class="stages-label">Tahapan Seleksi:</span>
                <div class="stages-tags">
                  {a.stages.map((st) => (
                    isLink(st.driveUrl) ? (
                      <a href={st.driveUrl} target="_blank" rel="noopener" class="stage-tag is-link" title={`Unduh sertifikat ${st.name}`}>
                        <span>{st.name.replace('Samsung Innovation Campus - ', '')}</span>
                        <ExternalLink size={10} aria-hidden="true" />
                      </a>
                    ) : (
                      <span class="stage-tag">{st.name.replace('Samsung Innovation Campus - ', '')}</span>
                    )
                  ))}
                </div>
              </div>
            )}

            <div class="card-links">
              {isLink(a.driveUrl) && (
                <a href={a.driveUrl} target="_blank" rel="noopener" class="card-link primary">
                  <span>Sertifikat Semi Finalis (PDF)</span>
                  <ExternalLink size={13} aria-hidden="true" />
                </a>
              )}
              {isLink(a.folderUrl) && (
                <a href={a.folderUrl} target="_blank" rel="noopener" class="card-link">
                  <span>Folder Drive SIC</span>
                  <ExternalLink size={13} aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Unified Skill Domain Cards & Verified Certificate Carousel */}
    <CertificateShowcase />
  </div>
</section>

<style>
  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .section-icon {
    color: var(--accent);
    flex-shrink: 0;
  }
  .section-head h2 {
    margin: 0;
    font-size: var(--step-2);
  }
  .section-lead {
    color: var(--text-2);
    font-size: var(--step--1);
    margin: 0;
    max-width: 100%;
    line-height: var(--leading-body, 1.65);
  }

  .programs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    min-width: 0;
  }
  @media (min-width: 48rem) {
    .programs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .program-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    overflow: hidden;
    min-width: 0;
    transition: border-color 0.2s ease;
  }
  .program-card:hover {
    border-color: var(--text-2);
  }
  .program-thumb {
    width: 100%;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .program-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-grow: 1;
    min-width: 0;
  }
  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .badge {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text-2);
    font-size: var(--step--2);
    font-weight: 600;
  }
  .badge-accent {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .badge-outline {
    border-color: var(--accent);
    color: var(--accent);
  }
  .program-title {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--text);
  }
  .program-issuer {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-2);
    font-weight: 500;
  }
  .program-note {
    margin: 0;
    font-size: var(--step-0);
    color: var(--text-2);
    line-height: var(--leading-body, 1.65);
  }

  .program-highlights {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--step--1);
    padding: 0;
    list-style: none;
  }
  .program-highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--text-2);
    line-height: 1.6;
  }
  .check-icon {
    color: #16a34a;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .stages-strip {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: var(--space-2);
  }
  .stages-label {
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .stages-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .stage-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--text);
  }
  .stage-tag.is-link {
    text-decoration: none;
    color: var(--text-2);
    transition: all 0.15s ease;
  }
  .stage-tag.is-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-2);
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg);
    transition: all 0.15s ease;
  }
  .card-link:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .card-link.primary {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
