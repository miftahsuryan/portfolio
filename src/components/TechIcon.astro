// Normalize input name string to matching key or Lucide fallback
const cleanName = name.toLowerCase().trim();
let brandKey: string | null = null;
let LucideFallback: any = null;

if (cleanName.includes('python')) brandKey = 'python';
else if (cleanName.includes('pytorch')) brandKey = 'pytorch';
else if (cleanName.includes('tensorflow') || cleanName.includes('keras')) brandKey = 'tensorflow';
else if (cleanName.includes('scikit') || cleanName.includes('sklearn')) brandKey = 'scikitlearn';
else if (cleanName.includes('streamlit')) brandKey = 'streamlit';
else if (cleanName.includes('pandas')) brandKey = 'pandas';
else if (cleanName.includes('numpy')) brandKey = 'numpy';
else if (cleanName.includes('plotly')) brandKey = 'plotly';
else if (cleanName.includes('fastapi')) brandKey = 'fastapi';
else if (cleanName.includes('github')) brandKey = 'github';
else if (cleanName.includes('git')) brandKey = 'git';
else if (cleanName.includes('docker')) brandKey = 'docker';
else if (cleanName.includes('esp32') || cleanName.includes('embedded') || cleanName.includes('iot') || cleanName.includes('hardware')) brandKey = 'espressif';
else if (cleanName.includes('sql') || cleanName.includes('relational') || cleanName.includes('pipeline etl') || cleanName.includes('data engineering')) brandKey = 'postgresql';
else if (cleanName.includes('genetic') || cleanName.includes('aga') || cleanName.includes('algoritma') || cleanName.includes('logika')) LucideFallback = Binary;
else if (cleanName.includes('quant') || cleanName.includes('finance') || cleanName.includes('yfinance') || cleanName.includes('optimasi portofolio')) LucideFallback = ChartLine;
else if (cleanName.includes('statist') || cleanName.includes('scipy') || cleanName.includes('inferensial')) LucideFallback = Activity;
else if (cleanName.includes('recommend') || cleanName.includes('cbf') || cleanName.includes('svd') || cleanName.includes('rekomendasi')) LucideFallback = Boxes;
else if (cleanName.includes('speech') || cleanName.includes('audio') || cleanName.includes('mqtt') || cleanName.includes('nlp')) LucideFallback = Radio;
else if (cleanName.includes('deep learning') || cleanName.includes('machine learning')) LucideFallback = Cpu;
else if (cleanName.includes('exploratory') || cleanName.includes('eda') || cleanName.includes('wrangling')) LucideFallback = BarChart2;
else if (cleanName.includes('computer vision') || cleanName.includes('vision') || cleanName.includes('time series')) LucideFallback = Scan;
else if (cleanName.includes('web') || cleanName.includes('javascript') || cleanName.includes('html')) LucideFallback = Code;
else LucideFallback = Terminal;

const svgPath = brandKey ? BRAND_PATHS[brandKey] : null;
---

{svgPath ? (
  <svg
    role="img"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="currentColor"
    aria-hidden="true"
    class={`tech-icon-svg ${className}`}
  >
    <path d={svgPath} />
  </svg>
) : LucideFallback ? (
  <LucideFallback size={size} stroke-width={1.8} class={`tech-icon-lucide ${className}`} aria-hidden="true" />
) : null}

<style>
  .tech-icon-svg,
  .tech-icon-lucide {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    opacity: 0.9;
  }
</style>
