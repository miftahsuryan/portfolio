---
import { ArrowRight } from '@lucide/astro';
import { getProfile } from '../lib/content';

const p = getProfile();
const services = p.services ?? [];
---

<section class="section" id="layanan" aria-labelledby="layanan-title">
  <div class="wrap services-container">
    <div class="section-head">
      <h2 id="layanan-title">Layanan</h2>
      <p class="section-lead">
        Bidang teknis yang sedang saya tekuni dan kembangkan. Terbuka untuk kesempatan kerja entry-level, program magang, maupun belajar dan berkontribusi dalam proyek kolaboratif.
      </p>
    </div>

    <div class="services-grid">
      {services.map((s) => (
        <article class="service-card">
          <div class="service-header">
            <h3>{s.title}</h3>
            <p class="service-summary">{s.summary}</p>
          </div>

          <div class="deliverables-block">
            <ul class="deliverables-list">
              {s.deliverables.map((item) => (
                <li>
                  <span class="deliverable-marker" aria-hidden="true">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="service-footer">
            <a href="#kontak" class="btn btn-primary service-cta-btn">
              <span>Diskusikan</span>
            </a>
            {s.projectSlug && (
              <a href={`#${s.projectSlug}`} class="service-sample-link">
                <span>Contoh Proyek</span>
                <ArrowRight size={13} aria-hidden="true" />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    min-width: 0;
  }

  @media (min-width: 54rem) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .service-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-2);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
    box-shadow: var(--card-shadow);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-card:hover {
    border-color: var(--text-2);
    transform: translateY(-2px);
  }

  .service-header h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--step-1);
    font-family: var(--font-heading);
    line-height: 1.3;
  }

  .service-summary {
    margin: 0;
    font-size: var(--step-0);
    color: var(--text-2);
    line-height: var(--leading-body, 1.65);
    max-width: none;
  }

  .deliverables-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    flex-grow: 1;
  }

  .deliverables-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .deliverables-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.6;
  }

  .deliverable-marker {
    font-family: var(--font-mono);
    color: var(--text-2);
    flex-shrink: 0;
    user-select: none;
  }

  .service-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    margin-top: auto;
  }

  .service-cta-btn {
    min-height: 2.35rem;
    padding: 0.35rem 0.85rem;
    font-size: var(--step--1);
  }

  .service-sample-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .service-sample-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

