---
import {
  Download,
  ArrowRight,
  ArrowUpRight,
} from '@lucide/astro';
import ImageSlot from './ImageSlot.astro';
import { getProfile, isLink, hasCvPdf } from '../lib/content';

const p = getProfile();
const e = p.education;
const pdf = hasCvPdf();
---

<section class="hero-bento" id="tentang" aria-labelledby="hero-title">
  <div class="wrap bento-container">
    {/* Row 1: Unified Profile Introduction Card */}
    <article class="bento-card hero-profile-card">
      <div class="profile-layout">
        {/* Left: Identity & Natural Narrative */}
        <div class="profile-info">
          <div class="tech-eyebrow">
            <span class="eyebrow-label">Machine Learning · Data Analytics · Portfolio Optimization</span>
          </div>

          <div class="name-block">
            <h1 id="hero-title" class="hero-name">{p.name}</h1>
            <div class="role-badge-row">
              <p class="role-title">{p.role}</p>
              <span class="role-sep" aria-hidden="true">·</span>
              <span class="honor-meta">S1 Informatika (IPK 3.77 Cumlaude)</span>
            </div>
          </div>

          <p class="tagline-lead">
            Senang mengolah data dan membangun model machine learning terapan dengan Python. Saya mengeksplorasi analisis data kuantitatif, algoritma optimasi, serta pembuatan pipeline dan visualisasi data.
          </p>

          <div class="hero-actions">
            {pdf ? (
              <a class="btn btn-primary" href="/cv.pdf" download>
                <Download size={16} aria-hidden="true" />
                <span>Unduh CV (PDF)</span>
              </a>
            ) : (
              <a class="btn btn-primary" href="/cv">
                <Download size={16} aria-hidden="true" />
                <span>Lihat & Cetak CV</span>
              </a>
            )}
            <a class="btn" href="#proyek">
              <span>Jelajahi Proyek</span>
              <ArrowRight size={16} aria-hidden="true" />
            </a>
            <a class="btn btn-outline" href="#kontak">
              <span>Hubungi Saya</span>
              <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          </div>
        </div>

        {/* Right: Proportional Portrait Photo & Social Links */}
        <div class="profile-photo-col">
          <div class="photo-wrap">
            <ImageSlot
              path={p.avatar}
              alt={p.avatarAlt}
              label="Foto Profil Formal"
              ratio="3 / 4"
              priority
              widths={[320, 480, 640]}
              sizes="(min-width: 48rem) 18rem, 70vw"
            />
          </div>

          <div class="photo-social-row">
            {isLink(p.contact.github) && (
              <a href={p.contact.github} target="_blank" rel="noopener noreferrer" class="photo-social-btn" title="GitHub Profile">
                <span>GitHub</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </a>
            )}
            {isLink(p.contact.linkedin) && (
              <a href={p.contact.linkedin} target="_blank" rel="noopener noreferrer" class="photo-social-btn" title="LinkedIn Profile">
                <span>LinkedIn</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </a>
            )}
          </div>
        </div>
      </div>
    </article>

    {/* Row 2: Clean Editorial Grid — Pendidikan, Riset & Organisasi */}
    <div class="credentials-grid">
      {/* Kartu Kiri: Pendidikan & Riset Tugas Akhir */}
      <article class="bento-card credential-card">
        <div class="cred-section">
          <div class="cred-eyebrow-row">
            <span class="cred-eyebrow">Pendidikan Formal</span>
            <span class="cred-period">{e.period}</span>
          </div>

          <div class="edu-main">
            <h2 class="cred-title">{e.institution}</h2>
            <p class="cred-subtitle">S1 Informatika · Fakultas Sains dan Teknologi</p>
          </div>

          <div class="edu-metrics">
            {e.showGpa && e.gpa && (
              <span class="metric-highlight">IPK {e.gpa} (Cumlaude)</span>
            )}
            <span class="metric-sep" aria-hidden="true">·</span>
            <span class="metric-text">Tingkat Akhir / Yudisium 2026</span>
          </div>
        </div>

        {e.thesis && (
          <div class="cred-section cred-divider">
            <div class="cred-eyebrow-row">
              <span class="cred-eyebrow">Tugas Akhir / Skripsi</span>
              <span class="cred-meta-tag">Machine Learning & Kuantitatif</span>
            </div>

            <p class="thesis-heading">{e.thesis}</p>

            <a href="#proyek-1" class="cred-link">
              <span>Lihat Studi Kasus (Proyek 01)</span>
              <ArrowRight size={14} aria-hidden="true" />
            </a>
          </div>
        )}
      </article>

      {/* Kartu Kanan: Organisasi & Prestasi Kejuaraan */}
      <article class="bento-card credential-card">
        <div class="cred-section">
          <div class="cred-eyebrow-row">
            <span class="cred-eyebrow">Organisasi & Kepemimpinan</span>
          </div>

          <ul class="editorial-list">
            <li class="editorial-row">
              <div class="row-main">
                <strong class="row-title">Bendahara Umum</strong>
                <span class="row-org">PK IMM Fakultas Saintek UIN Sunan Kalijaga</span>
              </div>
              <span class="row-period">2024 – 2025</span>
            </li>
            <li class="editorial-row">
              <div class="row-main">
                <strong class="row-title">Divisi Media & Komunikasi</strong>
                <span class="row-org">PK IMM Fakultas Saintek UIN Sunan Kalijaga</span>
              </div>
              <span class="row-period">2023 – 2024</span>
            </li>
            <li class="editorial-row">
              <div class="row-main">
                <strong class="row-title">Ketua Divisi Basket & Kapten</strong>
                <span class="row-org">UKM Olahraga UIN Sunan Kalijaga</span>
              </div>
              <span class="row-period">2024 – 2025</span>
            </li>
          </ul>
        </div>

        <div class="cred-section cred-divider">
          <div class="cred-eyebrow-row">
            <span class="cred-eyebrow">Prestasi Kejuaraan</span>
            <span class="cred-meta-tag">Turnamen Basket Mahasiswa</span>
          </div>

          <ul class="editorial-list">
            <li class="editorial-row">
              <div class="row-main">
                <strong class="row-title">Juara 1 Basket Putra (Medali Emas)</strong>
                <span class="row-org">Pekan Olahraga Kampus UIN Sunan Kalijaga · Kapten Tim</span>
              </div>
              <span class="row-period">2025</span>
            </li>
            <li class="editorial-row">
              <div class="row-main">
                <strong class="row-title">Juara 3 Basket 3x3 (Medali Perunggu)</strong>
                <span class="row-org">Turnamen Regional FeArstyc FEB UNY se-DIY</span>
              </div>
              <span class="row-period">2024</span>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .hero-bento {
    position: relative;
    padding-block: var(--space-6) var(--space-7);
    min-width: 0;
  }

  .bento-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .bento-card {
    box-sizing: border-box;
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-2);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  @media (min-width: 52rem) {
    .bento-card {
      padding: var(--space-6);
    }
  }

  /* Row 1: Unified Hero Profile Card */
  .profile-layout {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-5);
    align-items: center;
    width: 100%;
  }
  @media (min-width: 52rem) {
    .profile-layout {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1 1 0%;
    min-width: 0;
  }

  .profile-photo-col {
    flex-shrink: 0;
    width: 100%;
    max-width: 17rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }
  @media (min-width: 52rem) {
    .profile-photo-col {
      width: 17rem;
    }
  }

  .tech-eyebrow {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.4;
    color: var(--accent);
    align-self: flex-start;
  }

  .name-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .hero-name {
    margin: 0;
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .role-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.65rem;
  }
  .role-title {
    margin: 0;
    font-size: var(--step-1);
    color: var(--text);
    font-weight: 600;
    line-height: 1.3;
  }
  .role-sep {
    color: var(--text-2);
    opacity: 0.5;
  }
  .honor-meta {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-2);
  }

  .tagline-lead {
    margin: 0;
    font-size: var(--step-0);
    color: var(--text-2);
    max-width: 58ch;
    line-height: var(--leading-body, 1.65);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .btn:hover {
    border-color: var(--text-2);
  }
  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .btn-primary:hover {
    background: var(--accent-2);
    border-color: var(--accent-2);
  }
  .btn-outline {
    background: transparent;
    color: var(--text-2);
  }
  .btn-outline:hover {
    color: var(--text);
    background: var(--bg);
  }

  /* Portrait Photo Column */
  .photo-wrap {
    position: relative;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .photo-wrap :global(.slot) {
    border: none;
    border-radius: 0;
    background: transparent;
  }
  .photo-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }

  .photo-social-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    width: 100%;
  }
  .photo-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--text-2);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    padding: 0.45rem 0.5rem;
    border-radius: var(--radius);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .photo-social-btn:hover {
    border-color: var(--text-2);
    color: var(--text);
  }

  /* Row 2: Clean Editorial Grid */
  .credentials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    min-width: 0;
  }
  @media (min-width: 52rem) {
    .credentials-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .credential-card {
    gap: var(--space-5);
    justify-content: flex-start;
  }

  .cred-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .cred-divider {
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .cred-eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .cred-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-2);
  }
  .cred-period,
  .cred-meta-tag {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  .edu-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .cred-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
  }
  .cred-subtitle {
    margin: 0;
    font-size: var(--step-0);
    color: var(--text-2);
    line-height: 1.5;
  }

  .edu-metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-size: var(--step--1);
    padding-top: 0.15rem;
  }
  .metric-highlight {
    font-weight: 600;
    color: var(--accent);
  }
  .metric-sep {
    color: var(--text-2);
    opacity: 0.5;
  }
  .metric-text {
    color: var(--text-2);
  }

  .thesis-heading {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
  }

  .cred-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    align-self: flex-start;
    margin-top: 0.15rem;
    transition: gap 0.15s ease;
  }
  .cred-link:hover {
    gap: 0.6rem;
    text-decoration: underline;
  }

  /* Editorial List (Organisasi & Kejuaraan) */
  .editorial-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .editorial-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
  }
  .editorial-row:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }
  .row-main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .row-title {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
  }
  .row-org {
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.4;
  }
  .row-period {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  @media (max-width: 34rem) {
    .editorial-row {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
