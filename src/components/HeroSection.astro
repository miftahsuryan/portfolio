---
import { Download, Mail, GraduationCap, Trophy, ArrowRight, ArrowUpRight, Sparkles } from '@lucide/astro';
import ImageSlot from './ImageSlot.astro';
import { getProfile, isLink } from '../lib/content';

const p = getProfile();
const e = p.education;

const focusAreas = [
  'Quantitative Finance & AGA',
  'Recommender System & GenAI',
  'Edge AI & Embedded IoT',
];

const metrics = [
  { value: '3.77 / 4.00', label: 'IPK S1 Informatika', sub: 'Predikat Pujian / Cumlaude' },
  { value: '936 Jam', label: 'Coding Camp DBS Foundation', sub: 'Students Full Graduate (Nilai A)' },
  { value: 'Semi Finalist', label: 'Samsung Innovation Campus', sub: 'Tingkat Nasional (Batch 5)' },
  { value: '19 Kredensial', label: 'Sertifikasi Terverifikasi', sub: '1.380+ Jam Pembelajaran' },
];
---

<section class="hero-bento" id="tentang" aria-labelledby="hero-title">
  <div class="wrap bento-container">
    {/* Row 1: Main Story Card & Portrait Card */}
    <div class="bento-row main-row">
      {/* Bento 1: Primary Identity & Story */}
      <article class="bento-card identity-card">
        <div class="status-pill">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>{p.availability}</span>
        </div>

        <div class="name-block">
          <h1 id="hero-title">{p.name}</h1>
          <p class="role-title">{p.role}</p>
        </div>

        <p class="tagline-lead">{p.tagline}</p>

        <div class="about-narrative">
          <p>{p.about}</p>
        </div>

        <div class="focus-pills" aria-label="Fokus Keahlian">
          {focusAreas.map((area) => (
            <span class="focus-pill">
              <Sparkles size={13} class="focus-icon" aria-hidden="true" />
              <span>{area}</span>
            </span>
          ))}
        </div>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/cv">
            <Download size={16} aria-hidden="true" />
            <span>Unduh CV</span>
          </a>
          <a class="btn" href="#proyek">
            <span>Jelajahi Proyek</span>
            <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a class="btn" href="#kontak">
            <Mail size={16} aria-hidden="true" />
            <span>Hubungi</span>
          </a>

          <div class="social-links">
            {isLink(p.contact.github) && (
              <a href={p.contact.github} target="_blank" rel="noopener" class="social-btn" title="GitHub Profile">
                <span>GitHub</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </a>
            )}
            {isLink(p.contact.linkedin) && (
              <a href={p.contact.linkedin} target="_blank" rel="noopener" class="social-btn" title="LinkedIn Profile">
                <span>LinkedIn</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </a>
            )}
          </div>
        </div>
      </article>

      {/* Bento 2: Portrait Card with Editorial Badge */}
      <article class="bento-card photo-card">
        <div class="photo-wrap">
          <ImageSlot
            path={p.avatar}
            alt={p.avatarAlt}
            label="Foto Profil Formal"
            ratio="3 / 4"
            priority
            widths={[320, 480, 640]}
            sizes="(min-width: 48rem) 20rem, 80vw"
          />
        </div>
        <div class="photo-caption">
          <GraduationCap size={18} class="caption-icon" aria-hidden="true" />
          <div class="caption-text">
            <strong>S1 Informatika</strong>
            <span>UIN Sunan Kalijaga · 2026</span>
          </div>
        </div>
      </article>
    </div>

    {/* Row 2: 4 Impact Metrics Strip */}
    <div class="metrics-grid" aria-label="Statistik Pencapaian Utama">
      {metrics.map((m) => (
        <div class="metric-card">
          <p class="metric-value">{m.value}</p>
          <p class="metric-label">{m.label}</p>
          <p class="metric-sub">{m.sub}</p>
        </div>
      ))}
    </div>

    {/* Row 3: Education & Thesis (Col 1) and Leadership & Basketball (Col 2) */}
    <div class="bento-row dual-row">
      {/* Bento 3: Formal Education & Thesis */}
      <article class="bento-card edu-card">
        <div class="card-head">
          <GraduationCap size={22} class="card-icon" aria-hidden="true" />
          <div>
            <h3>Pendidikan Formal & Riset Skripsi</h3>
            <p class="card-sub">{e.institution}</p>
          </div>
        </div>
        <div class="edu-body">
          <div class="degree-row">
            <span class="degree-name">{e.degree}</span>
            <span class="period-badge">Periode {e.period}</span>
            {e.showGpa && e.gpa && <span class="gpa-pill">IPK {e.gpa} (Cumlaude)</span>}
          </div>
          {e.thesis && (
            <div class="thesis-highlight">
              <span class="thesis-tag">Tugas Akhir / Skripsi</span>
              <p class="thesis-text">{e.thesis}</p>
              <a href="#proyek-1" class="thesis-link">
                <span>Pelajari Model Optimasi Portofolio IDX30</span>
                <ArrowRight size={14} aria-hidden="true" />
              </a>
            </div>
          )}
        </div>
      </article>

      {/* Bento 4: Leadership & Campus Athletics */}
      <article class="bento-card leadership-card">
        <div class="card-head">
          <Trophy size={22} class="card-icon trophy" aria-hidden="true" />
          <div>
            <h3>Kepemimpinan & Organisasi</h3>
            <p class="card-sub">Divisi Basket UKM Olahraga Kampus</p>
          </div>
        </div>
        <div class="leadership-body">
          <p class="role-desc">
            Menjabat sebagai <strong>Ketua Divisi Basket & Kapten Tim</strong> (2024 - 2025). Mengoordinasikan program pembinaan atlet mahasiswa, manajemen turnamen antar-fakultas, dan kepemimpinan taktis.
          </p>
          <ul class="achievements-list">
            <li class="achievement-item gold">
              <span class="medal-tag">🥇 Juara 1</span>
              <div>
                <strong>Pekan Olahraga Kampus UIN Sunan Kalijaga (2025)</strong>
                <span class="item-detail">Ketua Divisi & Kapten / Pemain Inti Tim Basket Putra</span>
              </div>
            </li>
            <li class="achievement-item bronze">
              <span class="medal-tag">🥉 Juara 3</span>
              <div>
                <strong>Lomba Basket 3x3 FeArstyc (2024)</strong>
                <span class="item-detail">Kompetisi Bola Basket 3x3 Antarmahasiswa se-Daerah Istimewa Yogyakarta</span>
              </div>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .hero-bento {
    padding-block: var(--space-6) var(--space-7);
    min-width: 0;
  }
  .bento-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .bento-row {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .main-row {
    grid-template-columns: 1fr;
  }
  @media (min-width: 52rem) {
    .main-row {
      grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 1fr);
      align-items: stretch;
    }
  }

  .bento-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    transition: border-color 0.2s ease;
  }
  .bento-card:hover {
    border-color: var(--text-2);
  }

  /* Identity Card */
  .identity-card {
    justify-content: space-between;
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-2);
    width: fit-content;
  }
  .pulse-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.4);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.6); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(22, 163, 74, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(22, 163, 74, 0); }
  }

  .name-block h1 {
    margin: 0;
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .role-title {
    margin: var(--space-1) 0 0;
    font-family: var(--font-heading);
    font-size: var(--step-1);
    color: var(--accent);
    font-weight: 600;
    line-height: 1.25;
  }

  .tagline-lead {
    font-size: var(--step-0);
    color: var(--text);
    font-weight: 500;
    line-height: 1.5;
    margin: 0;
  }

  .about-narrative {
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.65;
    border-left: 2px solid var(--accent);
    padding-left: var(--space-3);
  }
  .about-narrative p {
    margin: 0;
    max-width: none;
  }

  .focus-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .focus-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--text);
  }
  .focus-icon {
    color: var(--accent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .social-links {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }
  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-2);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg);
    transition: all 0.15s ease;
  }
  .social-btn:hover {
    color: var(--text);
    border-color: var(--text);
  }

  /* Photo Card */
  .photo-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .photo-wrap {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #c2c6ca;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 4;
    width: 100%;
    max-width: 20rem;
    margin-inline: auto;
  }
  .photo-wrap :global(.slot) {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 0;
    background: transparent;
  }
  .photo-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }
  .photo-caption {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: var(--step--1);
    max-width: 20rem;
    margin-inline: auto;
    width: 100%;
  }
  .caption-icon {
    color: var(--accent);
    flex-shrink: 0;
  }
  .caption-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .caption-text strong {
    color: var(--text);
    font-weight: 600;
  }
  .caption-text span {
    font-size: var(--step--2);
    color: var(--text-2);
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    min-width: 0;
  }
  @media (min-width: 52rem) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
    }
  }
  .metric-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: border-color 0.2s ease;
  }
  .metric-card:hover {
    border-color: var(--text-2);
  }
  .metric-value {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--accent);
    margin: 0;
    line-height: 1.1;
  }
  .metric-label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }
  .metric-sub {
    font-size: var(--step--2);
    color: var(--text-2);
    margin: 0;
    line-height: 1.35;
  }

  /* Dual Row */
  .dual-row {
    grid-template-columns: 1fr;
  }
  @media (min-width: 52rem) {
    .dual-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .card-head h3 {
    margin: 0;
    font-size: var(--step-0);
    font-family: var(--font-heading);
  }
  .card-sub {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-2);
    font-weight: 500;
  }
  .card-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .card-icon.trophy {
    color: #d97706;
  }

  .edu-body, .leadership-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-grow: 1;
  }
  .degree-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
  }
  .degree-name {
    font-weight: 600;
    color: var(--text);
  }
  .period-badge {
    color: var(--text-2);
    font-size: var(--step--2);
  }
  .gpa-pill {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: #fff;
    font-size: var(--step--2);
    font-weight: 600;
  }

  .thesis-highlight {
    padding: var(--space-3);
    background: var(--bg);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: auto;
  }
  .thesis-tag {
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .thesis-text {
    font-size: var(--step--1);
    color: var(--text);
    font-weight: 500;
    line-height: 1.45;
    margin: 0;
    max-width: none;
  }
  .thesis-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--accent);
    margin-top: var(--space-1);
    text-decoration: none;
  }
  .thesis-link:hover {
    text-decoration: underline;
  }

  .role-desc {
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.55;
    margin: 0;
  }
  .achievements-list {
    display: grid;
    gap: var(--space-2);
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }
  .achievement-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    font-size: var(--step--1);
  }
  .achievement-item.gold {
    border-left: 3px solid #d97706;
  }
  .achievement-item.bronze {
    border-left: 3px solid #b45309;
  }
  .medal-tag {
    font-weight: 700;
    font-size: var(--step--1);
    white-space: nowrap;
    color: var(--text);
  }
  .item-detail {
    display: block;
    font-size: var(--step--2);
    color: var(--text-2);
    margin-top: 0.1rem;
  }
</style>
