---
import { ArrowUpRight, Copy } from '@lucide/astro';
import { getProfile, isLink } from '../lib/content';

const c = getProfile().contact;
---

<section class="section" id="kontak" aria-labelledby="kontak-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="kontak-title">Kontak</h2>
    </div>
    <ul>
      <li>
        <span class="k">Email</span>
        <a href={`mailto:${c.email}`}>{c.email}</a>
        <button type="button" class="copy" data-copy={c.email}>
          <Copy size={16} aria-hidden="true" />
          <span data-copy-label>Salin</span>
        </button>
      </li>
      <li>
        <span class="k">LinkedIn</span>
        {isLink(c.linkedin) ? <a href={c.linkedin} rel="noopener">{c.linkedin.replace(/^https?:\/\//, '')}<ArrowUpRight size={16} aria-hidden="true" /></a> : <span>{c.linkedin}</span>}
      </li>
      <li>
        <span class="k">GitHub</span>
        {isLink(c.github) ? <a href={c.github} rel="noopener">{c.github.replace(/^https?:\/\//, '')}<ArrowUpRight size={16} aria-hidden="true" /></a> : <span>{c.github}</span>}
      </li>
    </ul>
    <p class="note" role="status" aria-live="polite" data-copy-status></p>
  </div>
</section>

<style>
  ul { max-width: 40rem; }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .k { min-width: 5.5rem; font-size: var(--step--1); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
  a { display: inline-flex; align-items: center; gap: var(--space-1); padding-block: var(--space-2); font-weight: 600; }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    font-size: var(--step--1);
    cursor: pointer;
  }
  .copy:hover { border-color: var(--text); }
  .note { min-height: 1.5rem; margin-top: var(--space-3); font-size: var(--step--1); color: var(--text-2); }
</style>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (status) status.textContent = 'Alamat email disalin.';
      } catch {
        if (status) status.textContent = 'Gagal menyalin. Silakan salin manual.';
      }
      setTimeout(() => status && (status.textContent = ''), 3000);
    });
  });
</script>
