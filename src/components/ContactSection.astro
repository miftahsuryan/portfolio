---
import { ArrowUpRight, Copy, Briefcase } from '@lucide/astro';
import { getProfile, isLink } from '../lib/content';

const p = getProfile();
const c = p.contact;
---

<section class="section" id="kontak" aria-labelledby="kontak-title">
  <div class="wrap contact-container">
    <div class="section-head">
      <h2 id="kontak-title">Kontak</h2>
      <p class="section-lead">
        Saluran komunikasi langsung untuk diskusi peluang kerja, program magang, maupun kolaborasi proyek teknis.
      </p>
    </div>

    <div class="contact-details-box">
      <div class="contact-grid">
        {/* Kolom Kiri: Email & LinkedIn */}
        <div class="contact-col">
          <div class="channel-item">
            <div class="channel-info">
              <span class="channel-label">Email</span>
              <a href={`mailto:${c.email}`} class="channel-value">{c.email}</a>
            </div>
            <button type="button" class="channel-action-btn copy-btn" data-copy={c.email} aria-label="Salin alamat email">
              <Copy size={15} aria-hidden="true" />
              <span data-copy-label>Salin</span>
            </button>
          </div>

          <div class="channel-item">
            <div class="channel-info">
              <span class="channel-label">LinkedIn</span>
              {isLink(c.linkedin) ? (
                <a href={c.linkedin} target="_blank" rel="noopener noreferrer" class="channel-value">
                  {c.linkedin.replace(/^https?:\/\//, '')}
                </a>
              ) : (
                <span class="channel-value">{c.linkedin}</span>
              )}
            </div>
            {isLink(c.linkedin) && (
              <a href={c.linkedin} target="_blank" rel="noopener noreferrer" class="channel-action-btn" title="Kunjungi LinkedIn">
                <span>Kunjungi</span>
                <ArrowUpRight size={15} aria-hidden="true" />
              </a>
            )}
          </div>
        </div>

        {/* Kolom Kanan: GitHub & Resume/CV */}
        <div class="contact-col">
          <div class="channel-item">
            <div class="channel-info">
              <span class="channel-label">GitHub</span>
              {isLink(c.github) ? (
                <a href={c.github} target="_blank" rel="noopener noreferrer" class="channel-value">
                  {c.github.replace(/^https?:\/\//, '')}
                </a>
              ) : (
                <span class="channel-value">{c.github}</span>
              )}
            </div>
            {isLink(c.github) && (
              <a href={c.github} target="_blank" rel="noopener noreferrer" class="channel-action-btn" title="Kunjungi GitHub">
                <span>Kunjungi</span>
                <ArrowUpRight size={15} aria-hidden="true" />
              </a>
            )}
          </div>

          <div class="channel-item">
            <div class="channel-info">
              <span class="channel-label">Resume / CV</span>
              <span class="channel-value">Curriculum Vitae Resmi (PDF)</span>
            </div>
            <a href="/cv" class="channel-action-btn" title="Buka Halaman CV">
              <span>Buka CV</span>
              <ArrowUpRight size={15} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <div class="contact-meta-strip">
        <div class="meta-item">
          <Briefcase size={16} class="meta-icon" aria-hidden="true" />
          <span>Siap bekerja On-site (WFO), Hybrid, maupun Remote</span>
        </div>
      </div>

      <p class="note" role="status" aria-live="polite" data-copy-status></p>
    </div>
  </div>
</section>

<style>
  .contact-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .contact-details-box {
    box-sizing: border-box;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-2);
    padding: var(--space-6);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    width: 100%;
  }

  @media (min-width: 52rem) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
    .contact-col:first-child {
      border-right: 1px solid var(--line);
      padding-right: var(--space-6);
    }
    .contact-col:last-child {
      padding-left: var(--space-6);
    }
  }

  .contact-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .channel-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }
  .contact-col:first-child .channel-item:first-child,
  .contact-col:last-child .channel-item:first-child {
    padding-top: 0;
  }
  @media (min-width: 52rem) {
    .contact-col .channel-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
  }

  .contact-meta-strip {
    display: flex;
    align-items: center;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-2);
    font-weight: 500;
  }
  .meta-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex-grow: 1;
  }

  .channel-label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .channel-value {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    word-break: break-word;
    transition: color 0.15s ease;
  }
  a.channel-value:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .channel-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text-2);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }
  .channel-action-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--bg-2);
  }

  .note {
    min-height: 1.5rem;
    margin: var(--space-2) 0 0;
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 34rem) {
    .contact-details-box {
      padding: var(--space-4);
    }
    .channel-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .channel-action-btn {
      align-self: flex-start;
    }
  }
</style>

<script>
  function setupCopy() {
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          if (status) status.textContent = 'Alamat email berhasil disalin ke papan klip.';
        } catch {
          if (status) status.textContent = 'Gagal menyalin. Silakan salin manual.';
        }
        setTimeout(() => status && (status.textContent = ''), 3000);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCopy);
  } else {
    setupCopy();
  }
  document.addEventListener('astro:page-load', setupCopy);
</script>
