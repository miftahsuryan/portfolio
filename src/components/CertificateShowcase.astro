---
import { ArrowUpRight, ChevronLeft, ChevronRight, Award, ExternalLink, Folder, Cpu, Database, Code, ShieldCheck } from '@lucide/astro';
import ImageSlot from './ImageSlot.astro';
import { getProfile, getSkillGroups, getProjects, isLink } from '../lib/content';

const p = getProfile();
const certs = p.certifications;
const groups = getSkillGroups();
const projects = await getProjects();
const projectIndex = new Map(projects.map((proj, i) => [proj.id, { n: String(i + 1).padStart(2, '0'), title: proj.data.title }]));

const driveFolders = [
  { name: 'Drive Arsip Sertifikat Lengkap', url: 'https://drive.google.com/drive/folders/1V5bDhtNTBCkgzyaPHYDgr3YvoQRDiW9e?usp=share_link' },
  { name: 'Drive 14 Sertifikat Dicoding', url: 'https://drive.google.com/drive/folders/1tO0_8rv0ZAS_MK8CZgv24ONS3bGckz1F?usp=share_link' },
  { name: 'Drive Coding Camp DBS', url: 'https://drive.google.com/drive/folders/11wTJi1BWYtmW_i7XFiSAfTkhv_jk-NK3?usp=share_link' },
  { name: 'Drive Samsung Innovation Campus', url: 'https://drive.google.com/drive/folders/1jOtxipwoEbbdnGidgdYIua-ccc5ZfUhm?usp=share_link' },
];

const categories = ['Semua', 'Program & Bootcamp', 'ML & AI', 'Data Science', 'Software Engineering', 'Bahasa & Komputasi'];

const domainConfig: Record<string, { icon: typeof Cpu; filterCat: string; label: string }> = {
  'Machine Learning & AI': { icon: Cpu, filterCat: 'ML & AI', label: 'ML & AI' },
  'Data Science & Analisis Kuantitatif': { icon: Database, filterCat: 'Data Science', label: 'Data Science' },
  'Pemrograman & Rekayasa Perangkat Lunak': { icon: Code, filterCat: 'Software Engineering', label: 'Software Eng.' },
};
---

<div class="skills-cert-section" id="skill" data-cert-showcase>
  {/* Sub-section: Keahlian Teknis Berdasarkan Domain */}
  <div class="skills-block">
    <div class="block-head">
      <span class="section-kicker">
        <Cpu size={12} aria-hidden="true" />
        <span>Kompetensi Teruji</span>
      </span>
      <h3 id="skill-title">Keahlian Teknis Berdasarkan Domain</h3>
      <p class="block-lead">
        Kompetensi praktis yang teruji pada 3 proyek portofolio (ditandai dengan badge nomor proyek) dan diperkuat oleh {certs.length} sertifikasi terverifikasi.
      </p>
    </div>

    <div class="domains-grid">
      {groups.map((g) => {
        const config = domainConfig[g.category] ?? { icon: Award, filterCat: 'Semua', label: g.category };
        const IconComponent = config.icon;
        const certCount = certs.filter(c => c.category === config.filterCat).length;
        return (
          <article class="domain-card">
            <div class="domain-head">
              <div class="domain-icon-wrap">
                <IconComponent size={20} class="domain-icon" aria-hidden="true" />
              </div>
              <div>
                <h4>{g.category}</h4>
                <p class="domain-stats">{g.items.length} Keahlian · {certCount} Sertifikasi</p>
              </div>
            </div>

            <ul class="skills-chips">
              {g.items.map((it) => (
                <li class="skill-chip">
                  <span class="skill-name">{it.name}</span>
                  {it.projectSlugs.length > 0 && (
                    <span class="chip-projects" aria-label={`Dipakai di proyek`}>
                      {it.projectSlugs.map((slug) => {
                        const pr = projectIndex.get(slug);
                        return pr ? (
                          <a href={`#${slug}`} class="proj-badge" title={`Lompat ke Proyek ${pr.n}: ${pr.title}`}>
                            {pr.n}
                          </a>
                        ) : null;
                      })}
                    </span>
                  )}
                </li>
              ))}
            </ul>

            <div class="domain-foot">
              <button
                type="button"
                class="domain-filter-btn"
                data-trigger-filter={config.filterCat}
                aria-label={`Tampilkan sertifikat kategori ${config.label}`}
              >
                <span>Lihat Sertifikat {config.label} ({certCount})</span>
                <ChevronRight size={14} aria-hidden="true" />
              </button>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  {/* Sub-section: Galeri Sertifikasi Kompetensi & Program (Carousel) */}
  <div class="cert-block" id="sertifikat">
    <div class="cert-head">
      <div>
        <span class="section-kicker">
          <ShieldCheck size={12} aria-hidden="true" />
          <span>Kredensial Terverifikasi</span>
        </span>
        <h3 id="sertifikat-title">Sertifikasi & Kredensial Resmi</h3>
        <p class="cert-lead">
          <strong>{certs.length} kredensial & sertifikasi resmi terverifikasi</strong> dengan total <strong>1.400+ jam pembelajaran terstruktur</strong> (Dicoding Indonesia, Google Developers, AWS, Samsung Electronics Indonesia, DBS Foundation, TBI, dan UIN Sunan Kalijaga).
        </p>
      </div>

      <div class="head-actions">
        <div class="drive-dropdown" aria-label="Tautan folder Google Drive sertifikat">
          {driveFolders.map((f) => (
            <a href={f.url} target="_blank" rel="noopener" class="drive-btn">
              <Folder size={13} aria-hidden="true" />
              <span>{f.name}</span>
              <ExternalLink size={12} aria-hidden="true" />
            </a>
          ))}
        </div>
        <div class="nav-btns" aria-label="Navigasi geser sertifikat">
          <button type="button" class="nav-btn" data-cert-prev aria-label="Sertifikat sebelumnya">
            <ChevronLeft size={16} aria-hidden="true" />
          </button>
          <button type="button" class="nav-btn" data-cert-next aria-label="Sertifikat berikutnya">
            <ChevronRight size={16} aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>

    <div class="filter-bar" role="tablist" aria-label="Filter kategori sertifikat">
      {categories.map((cat, i) => (
        <button
          type="button"
          class={`filter-tab ${i === 0 ? 'active' : ''}`}
          data-filter={cat}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {cat} {cat === 'Semua' ? `(${certs.length})` : `(${certs.filter(c => c.category === cat).length})`}
        </button>
      ))}
    </div>

    <div class="cert-track" data-cert-track tabindex="0" role="region" aria-label="Daftar sertifikat kompetensi">
      {certs.map((c) => (
        <article class="cert-card" data-category={c.category ?? 'Lainnya'}>
          <div class="cert-thumb">
            <ImageSlot
              path={c.image ?? null}
              alt={`Sertifikat ${c.name} - ${c.issuer}`}
              label={c.name}
              ratio="1.414 / 1"
              widths={[320, 600, 900]}
              sizes="(min-width: 48rem) 24rem, 85vw"
            />
          </div>
          <div class="cert-body">
            <div class="cert-badges">
              {c.hours && <span class="badge badge-accent">{c.hours}</span>}
              {c.category && <span class="badge">{c.category}</span>}
              <span class="badge badge-year">{c.year}</span>
            </div>
            <h4>{c.name}</h4>
            <p class="issuer">{c.issuer}</p>
            {c.summary && <p class="summary">{c.summary}</p>}
            <div class="cert-links">
              {isLink(c.verificationUrl) && (
                <a href={c.verificationUrl} target="_blank" rel="noopener" class="cert-link primary">
                  <span>Verifikasi</span>
                  <ArrowUpRight size={14} aria-hidden="true" />
                </a>
              )}
              {isLink(c.driveUrl) && (
                <a href={c.driveUrl} target="_blank" rel="noopener" class="cert-link">
                  <span>Lihat PDF</span>
                  <ExternalLink size={14} aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  .skills-cert-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
    margin-top: var(--space-6);
    min-width: 0;
  }

  /* Skills Block */
  .skills-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }
  .block-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .header-icon {
    color: var(--accent);
    flex-shrink: 0;
  }
  .block-head h3, .cert-head h3 {
    margin: 0;
    font-size: var(--step-1);
    font-family: var(--font-heading);
  }
  .block-lead, .cert-lead {
    color: var(--text-2);
    font-size: var(--step--1);
    margin: 0;
    max-width: var(--measure);
    line-height: 1.55;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    min-width: 0;
  }
  @media (min-width: 54rem) {
    .domains-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .domain-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    transition: border-color 0.2s ease;
  }
  .domain-card:hover {
    border-color: var(--text-2);
  }

  .domain-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .domain-icon-wrap {
    width: 2.35rem;
    height: 2.35rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--accent);
  }
  .domain-card h4 {
    margin: 0;
    font-size: var(--step-0);
    font-family: var(--font-heading);
    color: var(--text);
    line-height: 1.25;
  }
  .domain-stats {
    margin: 0;
    font-size: var(--step--2);
    color: var(--text-2);
    font-weight: 500;
  }

  .skills-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    flex-grow: 1;
    align-content: flex-start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: var(--step--2);
    color: var(--text);
    line-height: 1.25;
    font-weight: 500;
  }
  .skill-name {
    word-break: break-word;
  }
  .chip-projects {
    display: inline-flex;
    gap: 0.2rem;
    margin-inline-start: 0.1rem;
  }
  .proj-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    text-decoration: none;
    line-height: 1;
    transition: opacity 0.15s ease;
  }
  .proj-badge:hover {
    opacity: 0.8;
  }

  .domain-foot {
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    margin-top: auto;
  }
  .domain-filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.35rem 0.6rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-2);
    font-size: var(--step--2);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .domain-filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--bg);
  }

  /* Cert Block */
  .cert-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--line);
    min-width: 0;
  }
  .cert-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .head-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .drive-dropdown {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .drive-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    color: var(--text-2);
    font-size: var(--step--2);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .drive-btn:hover {
    border-color: var(--text);
    background: var(--bg);
    color: var(--text);
  }
  .nav-btns { display: inline-flex; gap: var(--space-1); }
  .nav-btn {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    color: var(--text);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .nav-btn:hover {
    border-color: var(--text);
    background: var(--bg);
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filter-tab {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--text-2);
    font-size: var(--step--1);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter-tab:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .filter-tab.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    font-weight: 600;
  }
  .cert-track {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.25rem;
    padding-bottom: var(--space-3);
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    min-width: 0;
    max-width: 100%;
  }
  .cert-card {
    flex: 0 0 min(85vw, 24rem);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    overflow: hidden;
    min-width: 0;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .cert-card:hover {
    border-color: var(--text-2);
  }
  .cert-card.is-hidden {
    display: none;
  }
  .cert-thumb {
    width: 100%;
    aspect-ratio: 1.414 / 1;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cert-thumb :global(.slot) {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 0;
    background: transparent;
  }
  .cert-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cert-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex-grow: 1;
  }
  .cert-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    font-size: var(--step--2);
  }
  .badge {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text-2);
    font-weight: 600;
  }
  .badge-accent {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .badge-year {
    color: var(--text-2);
  }
  .cert-body h4 {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.35;
    color: var(--text);
  }
  .issuer {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-2);
  }
  .summary {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.5;
    flex-grow: 1;
  }
  .cert-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    margin-top: auto;
  }
  .cert-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-2);
    text-decoration: none;
  }
  .cert-link:hover {
    color: var(--text);
  }
  .cert-link.primary {
    color: var(--accent);
  }
</style>

<script>
  document.querySelectorAll('[data-cert-showcase]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-cert-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-cert-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-cert-next]');
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = root.querySelectorAll<HTMLElement>('.cert-card');
    const domainTriggers = root.querySelectorAll<HTMLButtonElement>('[data-trigger-filter]');

    function applyFilter(category: string) {
      tabs.forEach((t) => {
        const isMatch = (t.getAttribute('data-filter') ?? '') === category;
        t.classList.toggle('active', isMatch);
        t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') ?? '';
        if (category === 'Semua' || cat === category) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });

      if (track) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      }
    }

    if (track && prev && next) {
      prev.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.cert-card:not(.is-hidden)');
        const step = (card?.clientWidth ?? 320) + 16;
        track.scrollBy({ left: -step, behavior: 'smooth' });
      });
      next.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.cert-card:not(.is-hidden)');
        const step = (card?.clientWidth ?? 320) + 16;
        track.scrollBy({ left: step, behavior: 'smooth' });
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter') ?? 'Semua';
        applyFilter(filter);
      });
    });

    domainTriggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCategory = btn.getAttribute('data-trigger-filter') ?? 'Semua';
        applyFilter(targetCategory);
        const certBlock = root.querySelector('#sertifikat');
        if (certBlock) {
          certBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>
